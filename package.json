{
  "name": "tracelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests *.json *.ts index.html",
    "format:check": "prettier --check src tests *.json *.ts index.html",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.mjs && node tests/product-browser.mjs",
    "test:real": "node tests/real-documents.mjs",
    "test:vnext": "node tests/vnext-corpus.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser:product": "node tests/product-browser.mjs",
    "test:browser:scoped": "node tests/scoped-browser.mjs && node tests/scoped-degradation-browser.mjs",
    "test:browser:p2": "node tests/p2-regression-browser.mjs",
    "test:browser:full-scope": "node tests/full-scope-browser.mjs",
    "test:browser:structure": "node tests/structure-browser.mjs",
    "test:browser:overview": "node tests/overview-browser.mjs",
    "test:browser:focus": "node tests/binding-focus-browser.mjs",
    "test:browser:features": "node tests/requirement-task-navigation-browser.mjs && node tests/requirement-features-real-browser.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.49.0",
    "mdast-util-to-string": "^4.0.0",
    "minimatch": "^10.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
