{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnext.local/schemas/product-doc-v2.json",
  "$defs": {
    "SourceRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "item_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
            },
            "section": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "lines": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "uri"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "uri"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "text",
            "label"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TaskRef": {
      "type": "object",
      "properties": {
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "plan_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "step_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "task_id",
        "source"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "relation": {
          "type": "string",
          "enum": [
            "part_of",
            "supports",
            "addresses",
            "depends_on",
            "replaces",
            "derived_from",
            "discusses",
            "references"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "origin": {
          "type": "string",
          "enum": [
            "declared",
            "inferred"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "dismissed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "relation",
        "target",
        "origin",
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "inferred"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "reason",
              "sources"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "dismissed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "TaskBinding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "role": {
          "type": "string",
          "enum": [
            "implementation",
            "repair",
            "verification",
            "exploration",
            "reference"
          ]
        },
        "coverage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origin": {
          "type": "string",
          "enum": [
            "declared",
            "inferred"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "dismissed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0
        },
        "plan_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "plan_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "work_item_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              }
            },
            "required": [
              "plan_id",
              "work_item_id"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task": {
                "$ref": "#/$defs/TaskRef"
              },
              "coverage": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              }
            },
            "required": [
              "task",
              "coverage",
              "sources"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "task",
        "role",
        "coverage",
        "origin",
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "inferred"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "reason",
              "sources"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "dismissed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "WorkItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "coverage": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "target",
              "coverage"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "included",
            "deferred",
            "withdrawn"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "initial",
            "added",
            "unknown"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "order",
                  "prerequisite"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "item_id",
              "kind",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "title",
        "outcome",
        "scope",
        "targets",
        "state",
        "origin"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "vnext-product-doc/v2"
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Link"
                },
                "minItems": 0
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              },
              "extensions": {
                "type": "object"
              },
              "type": {
                "const": "project"
              },
              "inventory": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "partial",
                      "reconciled"
                    ]
                  },
                  "checked_sources": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/SourceRef"
                    },
                    "minItems": 0
                  },
                  "unreviewed_sources": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/SourceRef"
                    },
                    "minItems": 0
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "state",
                  "checked_sources",
                  "unreviewed_sources"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "inventory"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "inventory": {
                      "properties": {
                        "state": {
                          "const": "reconciled"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "inventory": {
                      "properties": {
                        "checked_sources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/SourceRef"
                          },
                          "minItems": 1
                        },
                        "unreviewed_sources": {
                          "type": "array",
                          "maxItems": 0
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Link"
                },
                "minItems": 0
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              },
              "extensions": {
                "type": "object"
              },
              "type": {
                "const": "goal"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "current",
                  "planned",
                  "candidate",
                  "retired"
                ]
              },
              "task_bindings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/TaskBinding"
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "type",
              "scope"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Link"
                },
                "minItems": 0
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              },
              "extensions": {
                "type": "object"
              },
              "type": {
                "const": "module"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "current",
                  "planned",
                  "candidate",
                  "retired"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "scope"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Link"
                },
                "minItems": 0
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              },
              "extensions": {
                "type": "object"
              },
              "type": {
                "const": "requirement"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "current",
                  "planned",
                  "candidate",
                  "retired"
                ]
              },
              "assessment_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "task_bindings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/TaskBinding"
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "type",
              "scope"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Link"
                },
                "minItems": 0
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              },
              "extensions": {
                "type": "object"
              },
              "type": {
                "const": "design"
              },
              "intent_state": {
                "type": "string",
                "enum": [
                  "proposed",
                  "adopted",
                  "retired"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "intent_state"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Link"
                },
                "minItems": 0
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              },
              "extensions": {
                "type": "object"
              },
              "type": {
                "const": "change"
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "basis": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "user",
                      "delegated",
                      "document-edit"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/SourceRef"
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              "deltas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
                    },
                    "before": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "after": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "target",
                    "before",
                    "after"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "type",
              "recorded_at",
              "basis",
              "deltas"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "links": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Link"
                },
                "minItems": 0
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              },
              "extensions": {
                "type": "object"
              },
              "type": {
                "const": "assessment"
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
              },
              "target_basis": {
                "$ref": "#/$defs/SourceRef"
              },
              "target_definition_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checked_at": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "subject": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "working-copy",
                      "commit",
                      "release",
                      "unknown"
                    ]
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              "implementation": {
                "type": "string",
                "enum": [
                  "unknown",
                  "none-reported",
                  "partial-reported",
                  "delivered-reported"
                ]
              },
              "verification": {
                "type": "string",
                "enum": [
                  "unknown",
                  "not-run-reported",
                  "failure-reported",
                  "pass-reported",
                  "mixed-reported"
                ]
              },
              "pending_sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "type",
              "target",
              "target_basis",
              "target_definition_sha256",
              "checked_at",
              "subject",
              "implementation",
              "verification"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "properties": {
                  "target_basis": {
                    "properties": {
                      "kind": {
                        "const": "file"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
